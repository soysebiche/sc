{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/sitemap-(.*).xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-SNhMQtjHys7876gZ9yH7wHPybDFKDaZJg3C2eIlL4Q4=' https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.google-analytics.com; connect-src 'self' https://*.google-analytics.com https://www.googletagmanager.com https://cloudflareinsights.com; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/sporting-cristal.ics",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/calendar; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"sporting-cristal.ics\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=1800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.celeste.sebiche.com"
        }
      ],
      "destination": "https://celeste.sebiche.com/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path+/index.html",
      "destination": "/:path+",
      "permanent": true
    },
    { "source": "/celeste", "destination": "/", "permanent": true },
    { "source": "/celeste/:path*", "destination": "/:path*", "permanent": true },
    { "source": "/en", "destination": "/", "permanent": true },
    { "source": "/es", "destination": "/", "permanent": true },
    { "source": "/en/:path*", "destination": "/:path*", "permanent": true },
    { "source": "/es/:path*", "destination": "/:path*", "permanent": true },
    { "source": "/partido", "destination": "/partidos", "permanent": true },
    { "source": "/partido/:path*", "destination": "/partidos/:path*", "permanent": true },
    { "source": "/matches", "destination": "/partidos", "permanent": true },
    { "source": "/matches/:path*", "destination": "/partidos/:path*", "permanent": true },
    { "source": "/match", "destination": "/partidos", "permanent": true },
    { "source": "/match/:path*", "destination": "/partidos/:path*", "permanent": true },
    { "source": "/rivals", "destination": "/rivales", "permanent": true },
    { "source": "/rivals/:path*", "destination": "/rivales/:path*", "permanent": true },
    { "source": "/rival", "destination": "/rivales", "permanent": true },
    { "source": "/rival/:path*", "destination": "/rivales/:path*", "permanent": true },
    { "source": "/seasons", "destination": "/temporadas", "permanent": true },
    { "source": "/seasons/:path*", "destination": "/temporadas/:path*", "permanent": true },
    { "source": "/season", "destination": "/temporadas", "permanent": true },
    { "source": "/season/:path*", "destination": "/temporadas/:path*", "permanent": true },
    { "source": "/temporada", "destination": "/temporadas", "permanent": true },
    { "source": "/temporada/:path*", "destination": "/temporadas/:path*", "permanent": true },
    { "source": "/countries", "destination": "/paises", "permanent": true },
    { "source": "/countries/:path*", "destination": "/paises/:path*", "permanent": true },
    { "source": "/country", "destination": "/paises", "permanent": true },
    { "source": "/country/:path*", "destination": "/paises/:path*", "permanent": true },
    { "source": "/pais", "destination": "/paises", "permanent": true },
    { "source": "/pais/:path*", "destination": "/paises/:path*", "permanent": true },
    { "source": "/players", "destination": "/jugadores", "permanent": true },
    { "source": "/players/:path*", "destination": "/jugadores/:path*", "permanent": true },
    { "source": "/player", "destination": "/jugadores", "permanent": true },
    { "source": "/player/:path*", "destination": "/jugadores/:path*", "permanent": true },
    { "source": "/jugador", "destination": "/jugadores", "permanent": true },
    { "source": "/jugador/:path*", "destination": "/jugadores/:path*", "permanent": true },
    { "source": "/goleadores", "destination": "/jugadores", "permanent": true },
    { "source": "/goleadores/:path*", "destination": "/jugadores/:path*", "permanent": true },
    { "source": "/goleador", "destination": "/jugadores", "permanent": true },
    { "source": "/goleador/:path*", "destination": "/jugadores/:path*", "permanent": true },
    { "source": "/scorers", "destination": "/jugadores", "permanent": true },
    { "source": "/scorers/:path*", "destination": "/jugadores/:path*", "permanent": true },
    { "source": "/scorer", "destination": "/jugadores", "permanent": true },
    { "source": "/scorer/:path*", "destination": "/jugadores/:path*", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    }
  ],
  "functions": {
    "api/share/index.js": {
      "includeFiles": "src/data/**"
    },
    "api/og/index.mjs": {
      "includeFiles": "src/data/**",
      "maxDuration": 10
    }
  }
}
